// SoftLib ASC SIMD MicroAPI — dual-64 SV5 8K absmax via VAND clear-sign-bit
// Abs = VAND(~0x80000000u, x)  (IEEE float sign-bit clear; emits RV_VAND / ADD unit, dual-issue)
// Instr family: VLDI / VAND / VCGMAX / VST  (NO VMUL/VMAX abs)
// Phys VL=64. SoftLib vcgmax = datablock G=8; pair-max -> gold G=16 (8 outputs/row).
#include "c_api/asc_simd.h"
#include "kernel_operator.h"

#ifndef R_DIM
#define R_DIM 64
#endif
#ifndef C_DIM
#define C_DIM 128
#endif
#ifndef PHYS_VL
#define PHYS_VL 64
#endif
#ifndef GOLD_G
#define GOLD_G 16
#endif
#ifndef SLOT
#define SLOT 8
#endif

static constexpr int NG_GOLD = PHYS_VL / GOLD_G; // 4
static constexpr int N_TRIPS = C_DIM / PHYS_VL;  // 2
static constexpr int Y_STRIDE = N_TRIPS * NG_GOLD * SLOT; // 64
static constexpr int X_ELEMS = R_DIM * C_DIM;
static constexpr int Y_ELEMS = R_DIM * Y_STRIDE;

__aicore__ inline void pair_max_scratch_to_gold(__ubuf__ float* y_ub) {
  for (uint16_t i = 0; i < (uint16_t)R_DIM; ++i) {
    __ubuf__ float* yrow = y_ub + (uint32_t)i * Y_STRIDE;
    for (int k = 0; k < NG_GOLD; ++k) {
      float a = yrow[16 + 2 * k];
      float b = yrow[16 + 2 * k + 1];
      float m = a;
      if (b > m) m = b;
      yrow[k] = m;
    }
    for (int k = 0; k < NG_GOLD; ++k) {
      float a = yrow[48 + 2 * k];
      float b = yrow[48 + 2 * k + 1];
      float m = a;
      if (b > m) m = b;
      yrow[NG_GOLD * SLOT + k] = m;
    }
  }
}

__simd_vf__ inline void absmax_vand_body(__ubuf__ float* x_ub, __ubuf__ float* y_ub) {
  vector_bool mask = asc_create_mask_b32(PAT_ALL);

  // Clear-sign mask: ~0x80000000u == 0x7FFFFFFFu, bitcast to float for asc_and(vector_float)
  uint32_t clear_u = ~static_cast<uint32_t>(0x80000000u);
  float clear_f = *reinterpret_cast<float*>(&clear_u);
  vector_float clear_sign;
  asc_duplicate_scalar(clear_sign, clear_f, mask);

  for (uint16_t i = 0; i < (uint16_t)R_DIM; ++i) {
    __ubuf__ float* row = x_ub + (uint32_t)i * C_DIM;
    __ubuf__ float* yrow = y_ub + (uint32_t)i * Y_STRIDE;

    vector_float x0, x1, a0, a1, r0, r1;
    asc_loadalign(x0, row + 0);
    asc_loadalign(x1, row + PHYS_VL);
    // abs via VAND clear-sign (ADD unit, dual-issue) — replaces VMUL(-1)+VMAX
    asc_and(a0, x0, clear_sign, mask);
    asc_and(a1, x1, clear_sign, mask);
    asc_reduce_max_datablock(r0, a0, mask); // vcgmax
    asc_reduce_max_datablock(r1, a1, mask);
    asc_storealign(yrow + 16, r0, mask);
    asc_storealign(yrow + 48, r1, mask);
  }
}

extern "C" __global__ __vector__ void main_kernel(__gm__ void* y_gm_, __gm__ void* x_gm_) {
  __gm__ float* y_gm = (__gm__ float*)y_gm_;
  __gm__ float* x_gm = (__gm__ float*)x_gm_;
  AscendC::InitSocState();
  __ubuf__ float* x_ub = (__ubuf__ float*)0;
  __ubuf__ float* y_ub = x_ub + X_ELEMS;

  copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)x_ub, (__gm__ uint8_t*)x_gm,
                           0, 1, (uint32_t)(X_ELEMS * 4), 0, 0, 0, 0,
                           (uint32_t)(X_ELEMS * 4), (uint32_t)(X_ELEMS * 4));
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);

  asc_vf_call<absmax_vand_body>(x_ub, y_ub);

  AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
  AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
  pair_max_scratch_to_gold(y_ub);
  AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(0);
  AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(0);

  copy_ubuf_to_gm_align_v2((__gm__ void*)y_gm, (__ubuf__ void*)y_ub,
                           0, 1, (uint32_t)(Y_ELEMS * 4), 4,
                           (uint32_t)(Y_ELEMS * 4), (uint32_t)(Y_ELEMS * 4));
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* y, void* x, void* stream) {
  main_kernel<<<(1), 16384, stream>>>((__gm__ float*)y, (__gm__ float*)x);
  return 0;
}
