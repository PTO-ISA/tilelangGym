#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

// Out[n] = sum_k A[n, k] * x[k]
// A is fp16, shape (4096, 32), contiguous in k. x is fp16. Out is fp32.
// 256 threads, 8 warps. Each warp owns 256 outputs. Lane L holds x[L] and
// loads A[n, L], so one warp reads one row as 32 adjacent halves.
// The buffer holds one slab of 2048 rows. Two VF launches cover N.

__simt_vf__ __launch_bounds__(256) inline void simt_vf_0(__ubuf__ uint8_t* buf_dyn_shmem, int s) {
  const int tid = (int)threadIdx.x;
  const int lane = tid & 31;
  const int wid = tid >> 5;
  __ubuf__ half* A = (__ubuf__ half*)buf_dyn_shmem;
  __ubuf__ half* X = A + 73728;
  __ubuf__ float* Out = ((__ubuf__ float*)buf_dyn_shmem) + 32768;
  float xk = (float)X[lane];
  for (int i = 0; i < 256; ++i) {
    int n = wid * 256 + i;
    float prod = ((float)A[n * 32 + lane]) * xk;
    float sum = asc_reduce_add(prod);
    if (lane == 0) {
      Out[s * 2048 + n] = sum;
    }
  }
}

extern "C" __global__ __vector__ void main_kernel(__gm__ half* A, __gm__ half* X, __gm__ float* Out) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)(&(((__ubuf__ half*)buf)[73728])), (__gm__ uint8_t*)(&(X[0])), 1, 64, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 64, 64);
  for (int s = 0; s < 2; ++s) {
    event_t ev = static_cast<event_t>(s);
    if (s > 0) {
      asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
    }
    asc_copy_gm2ub_align((__ubuf__ uint8_t*)(&(((__ubuf__ half*)buf)[0])), (__gm__ uint8_t*)(&(A[s * 65536])), 1, 131072, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 131072, 131072);
    asc_sync_notify(PIPE_MTE2, PIPE_V, ev);
    asc_sync_wait(PIPE_MTE2, PIPE_V, ev);
    asc_vf_call<simt_vf_0>(cce::dim3(256), buf, s);
    asc_sync_notify(PIPE_V, PIPE_MTE2, static_cast<event_t>(0));
  }
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(1));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(1));
  asc_copy_ub2gm_align((__gm__ uint8_t*)(&(Out[0])), (__ubuf__ uint8_t*)(&(((__ubuf__ float*)buf)[32768])), 1, 16384, static_cast<asc_store_l2_cache_mode>(4), 16384, 16384);
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(void* A, void* X, void* Out, void* stream) {
  main_kernel<<<(1 * 1 * 1), 16384, stream>>>((__gm__ half*)A, (__gm__ half*)X, (__gm__ float*)Out);
  return 0;
}
