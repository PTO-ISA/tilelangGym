#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

// 1024 threads. Copy 65536 fp16 values into the buffer, then read them with LDS.
// Adjacent lanes read adjacent halves: one issue is 64 bytes.
// 64 steps * 1024 threads * 2 bytes = 131072 bytes.

__simt_vf__ __launch_bounds__(1024) inline void main_kernel_simt_vf_0(__ubuf__ uint8_t* buf_dyn_shmem) {
  float acc[1];
  acc[0] = float(0x0p+0f/*0.000000e+00*/);
  for (int32_t step = 0; step < 64; ++step) {
    acc[0] = (acc[0] + ((float)((__ubuf__ half*)buf_dyn_shmem)[((step * 1024) + ((int32_t)threadIdx.x))]));
  }
  ((__ubuf__ float*)buf_dyn_shmem)[(((int32_t)threadIdx.x) + 32768)] = acc[0];
}

extern "C" __global__ __vector__ void main_kernel(__gm__ float* Dst, __gm__ half* Src) {
  asc_init();
  __ubuf__ uint8_t *buf_dyn_shmem = (__ubuf__ uint8_t *)0;
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)((&(((__ubuf__ half*)buf_dyn_shmem)[0]))), (__gm__ uint8_t*)((&(Src[0]))), 1, 131072, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), 131072, 131072);
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<main_kernel_simt_vf_0>(cce::dim3(1024), buf_dyn_shmem);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align((__gm__ uint8_t*)((&(Dst[0]))), (__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[32768]))), 1, 4096, static_cast<asc_store_l2_cache_mode>(4), 4096, 4096);
}

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }
extern "C" TL_EXPORT int call(half* __restrict__ Src, float* __restrict__ Dst, void* stream=nullptr) {
  main_kernel<<<(1 * 1 * 1), 16384, stream>>>(Dst, Src);
  return 0;
}
