#include <tl_templates/ascend/common.h>
#include <tl_templates/ascend/debug.h>

// 32 float32 values per thread. Loads are issued before any use, so one
// thread can hold several LDS or LDG in flight. Index is tid + k * threads,
// so a warp still touches 32 consecutive floats.

#ifndef SIMT_THREADS
#define SIMT_THREADS 256
#endif
#ifndef SIMT_OP
#define SIMT_OP 0
#endif

#define OP_LDS 0
#define OP_LDG 1
#define OP_STS 2
#define OP_FADD 3
#define OP_FFMA 4

constexpr int kThreads = SIMT_THREADS;
constexpr int kPerThread = 32;
constexpr int kFloats = kThreads * kPerThread;

#if SIMT_OP == OP_LDS || SIMT_OP == OP_STS
static_assert(kFloats * 2 * (int)sizeof(float) <= 248 * 1024, "UB");
#elif SIMT_OP == OP_FADD || SIMT_OP == OP_FFMA
static_assert(kFloats * 3 * (int)sizeof(float) <= 248 * 1024, "UB");
#endif

#if SIMT_OP == OP_LDS
__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  __ubuf__ float* src = (__ubuf__ float*)buf;
  __ubuf__ float* dst = src + kFloats;
  const int tid = (int)threadIdx.x;
  float v[kPerThread];
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
    v[k] = src[tid + k * kThreads];
  }
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
    dst[tid + k * kThreads] = v[k];
  }
}
#elif SIMT_OP == OP_LDG
__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__gm__ float* dst, __gm__ float* src) {
  const int tid = (int)threadIdx.x;
  float v[kPerThread];
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
    v[k] = src[tid + k * kThreads];
  }
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
    dst[tid + k * kThreads] = v[k];
  }
}
#elif SIMT_OP == OP_STS
__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  __ubuf__ float* dst = (__ubuf__ float*)buf;
  const int tid = (int)threadIdx.x;
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
    dst[tid + k * kThreads] = 1.0f;
  }
}
#elif SIMT_OP == OP_FADD || SIMT_OP == OP_FFMA
__simt_vf__ __launch_bounds__(kThreads) inline void simt_vf(__ubuf__ uint8_t* buf) {
  __ubuf__ float* src0 = (__ubuf__ float*)buf;
  __ubuf__ float* src1 = src0 + kFloats;
  __ubuf__ float* dst = src1 + kFloats;
  const int tid = (int)threadIdx.x;
  float a[kPerThread];
  float b[kPerThread];
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
    a[k] = src0[tid + k * kThreads];
    b[k] = src1[tid + k * kThreads];
  }
#pragma unroll
  for (int k = 0; k < kPerThread; ++k) {
#if SIMT_OP == OP_FFMA
    dst[tid + k * kThreads] = a[k] * b[k] + a[k];
#else
    dst[tid + k * kThreads] = a[k] + b[k];
#endif
  }
}
#endif

#if SIMT_OP == OP_LDG
extern "C" __global__ __vector__ void main_kernel(__gm__ float* dst, __gm__ float* src) {
  asc_init();
  asc_vf_call<simt_vf>(cce::dim3(kThreads), dst, src);
}
#else
extern "C" __global__ __vector__ void main_kernel(__gm__ float* dst, __gm__ float* src0, __gm__ float* src1) {
  asc_init();
  __ubuf__ uint8_t* buf = (__ubuf__ uint8_t*)0;
#if SIMT_OP == OP_STS
  (void)src0;
  (void)src1;
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align((__gm__ uint8_t*)dst, (__ubuf__ uint8_t*)buf, 1, kFloats * 4, static_cast<asc_store_l2_cache_mode>(4), kFloats * 4, kFloats * 4);
#elif SIMT_OP == OP_LDS
  (void)src1;
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)buf, (__gm__ uint8_t*)src0, 1, kFloats * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kFloats * 4, kFloats * 4);
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align((__gm__ uint8_t*)dst, (__ubuf__ uint8_t*)(((__ubuf__ float*)buf) + kFloats), 1, kFloats * 4, static_cast<asc_store_l2_cache_mode>(4), kFloats * 4, kFloats * 4);
#else
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)buf, (__gm__ uint8_t*)src0, 1, kFloats * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kFloats * 4, kFloats * 4);
  asc_copy_gm2ub_align((__ubuf__ uint8_t*)(((__ubuf__ float*)buf) + kFloats), (__gm__ uint8_t*)src1, 1, kFloats * 4, 0, 0, 0, static_cast<asc_load_l2_cache_mode>(0), kFloats * 4, kFloats * 4);
  asc_sync_notify(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_sync_wait(PIPE_MTE2, PIPE_V, static_cast<event_t>(0));
  asc_vf_call<simt_vf>(cce::dim3(kThreads), buf);
  asc_sync_notify(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_sync_wait(PIPE_V, PIPE_MTE3, static_cast<event_t>(0));
  asc_copy_ub2gm_align((__gm__ uint8_t*)dst, (__ubuf__ uint8_t*)(((__ubuf__ float*)buf) + 2 * kFloats), 1, kFloats * 4, static_cast<asc_store_l2_cache_mode>(4), kFloats * 4, kFloats * 4);
#endif
}
#endif

#ifdef _WIN32
#define TL_EXPORT __declspec(dllexport)
#else
#define TL_EXPORT
#endif
#define ERROR_BUF_SIZE 1024
static char error_buf[ERROR_BUF_SIZE];
extern "C" TL_EXPORT const char* get_last_error() { return error_buf; }
extern "C" TL_EXPORT int init() { error_buf[0] = '\0'; return 0; }

#if SIMT_OP == OP_LDG
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ float*)dst, (__gm__ float*)src);
  return 0;
}
#elif SIMT_OP == OP_LDS || SIMT_OP == OP_STS
extern "C" TL_EXPORT int call(void* dst, void* src, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ float*)dst, (__gm__ float*)src, (__gm__ float*)src);
  return 0;
}
#else
extern "C" TL_EXPORT int call(void* dst, void* src0, void* src1, void* stream) {
  main_kernel<<<1, 16384, stream>>>((__gm__ float*)dst, (__gm__ float*)src0, (__gm__ float*)src1);
  return 0;
}
#endif
