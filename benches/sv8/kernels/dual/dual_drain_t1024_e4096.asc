__simt_vf__ __launch_bounds__(1024) inline void simt_vf_0(__ubuf__ uint8_t* buf_dyn_shmem) {
  const int tid = (int32_t)threadIdx.x;
  __ubuf__ float* A0 = (__ubuf__ float*)buf_dyn_shmem;
  __ubuf__ float* C0 = (__ubuf__ float*)buf_dyn_shmem + 4096;
  // motif=warp-coop schedule=back_loadall_absall_dual_drain_e2e Case-3-e2e G=32 T=1024 axis=1xG KEEP-X
  const int lane = tid & 31;
  const int wid = tid >> 5;
  float a[4];
  float av[4];
  float s[4];
  a[0] = A0[0*1024 + tid];
  a[1] = A0[1*1024 + tid];
  a[2] = A0[2*1024 + tid];
  a[3] = A0[3*1024 + tid];
  asm volatile("" ::: "memory");  // wall LD
  { float v = a[0]; float x = v; if (v < 0.0f) x = -v; av[0] = x; }
  { float v = a[1]; float x = v; if (v < 0.0f) x = -v; av[1] = x; }
  { float v = a[2]; float x = v; if (v < 0.0f) x = -v; av[2] = x; }
  { float v = a[3]; float x = v; if (v < 0.0f) x = -v; av[3] = x; }
  asm volatile("" ::: "memory");  // wall ABS
  {
    float wm0 = asc_reduce_max(av[0]);
    float wm1 = asc_reduce_max(av[1]);
    float m0 = wm0; if (m0 < 1.0e-6f) m0 = 1.0e-6f;
    float m1 = wm1; if (m1 < 1.0e-6f) m1 = 1.0e-6f;
    s[0] = 1.0f / m0;
    s[1] = 1.0f / m1;
  }
  {
    float wm0 = asc_reduce_max(av[2]);
    float wm1 = asc_reduce_max(av[3]);
    float m0 = wm0; if (m0 < 1.0e-6f) m0 = 1.0e-6f;
    float m1 = wm1; if (m1 < 1.0e-6f) m1 = 1.0e-6f;
    s[2] = 1.0f / m0;
    s[3] = 1.0f / m1;
  }
  asm volatile("" ::: "memory");  // wall REDUX/recip
  C0[0*1024 + tid] = a[0] * s[0];
  C0[1*1024 + tid] = a[1] * s[1];
  C0[2*1024 + tid] = a[2] * s[2];
  C0[3*1024 + tid] = a[3] * s[3];
}

extern "C" __global__ __vector__ void main_kernel(__gm__ float* A, __gm__ float* B, __gm__ float* C) {
  AscendC::InitSocState();
  __ubuf__ uint8_t *buf_dyn_shmem = (__ubuf__ uint8_t *)0;
  copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t*)((&(((__ubuf__ float*)buf_dyn_shmem)[0]))), (__gm__ uint8_t*)((&(A[0]))), 0, 1, 16384, 0, 0, 0, 0, 16384, 16384);
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
  asc_vf_call<simt_vf_0>(cce::dim3(1024), buf_dyn_shmem);
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
  copy_ubuf_to_gm_align_v2((__gm__ void*)((&(C[0]))), (__ubuf__ void*)((&(((__ubuf__ float*)buf_dyn_shmem)[4096]))), 0, 1, 16384, 4, 16384, 16384);
}
